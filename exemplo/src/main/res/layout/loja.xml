<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pagar a encomenda"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:text="Nenhum campo desta aplicação está instrumentado. O SDK captura sozinho." />

        <EditText
            android:id="@+id/nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome no cartão"
            android:imeOptions="actionNext"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número do cartão"
            android:imeOptions="actionNext"
            android:inputType="number" />

        <EditText
            android:id="@+id/validade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Validade MM/AA"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <Button
            android:id="@+id/pagar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pagar 12.400 Kz" />

        <Button
            android:id="@+id/entrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrar na conta" />

        <Button
            android:id="@+id/falhar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedido que falha" />

        <!--
            As três armadilhas do cartão 4.1, e existem para se ver o que nenhuma
            ferramenta de funis mostra: um funil vê os passos que aconteceram, e
            nada disto é um passo.
        -->
        <TextView
            android:id="@+id/zona_morta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EFEAF7"
            android:gravity="center"
            android:padding="16dp"
            android:text="Precisa de ajuda? Fale connosco" />

        <Button
            android:id="@+id/confirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Confirmar encomenda" />

        <Button
            android:id="@+id/lento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Botão lento (2 segundos)" />

        <Button
            android:id="@+id/compose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir o ecrã em Compose" />

        <Button
            android:id="@+id/apoio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apoio, em fragmentos" />

        <!--
            As mensagens do cartão 5.1, e as quatro classes do RF-MSG-01. Nada
            disto está instrumentado: são vistas com o nome de recurso a dizer o
            que são, tal como qualquer aplicação as escreve.

            A primeira traz a **chave**, pela etiqueta `uxda:mensagem=`, e é o
            caminho que o RF-MSG-02 manda preferir: estável, independente do
            idioma, sem dados lá dentro. A segunda só tem texto, e é aí que o
            mascaramento do 5.2 tem de funcionar.
        -->
        <Button
            android:id="@+id/msg_chave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensagem com chave" />

        <Button
            android:id="@+id/msg_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensagem só com texto" />

        <Button
            android:id="@+id/msg_tecnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Erro que ninguém vê" />

        <!--
            O componente de inquérito dos cartões 14.1 e 14.2. O de esforço não tem botão:
            dispara sozinho, pelo gatilho `apos_conclusao`, quando se toca em pagar. Estes
            dois são a aplicação a pedir pela chave (`Uxda.inquerito`), que salta o
            sorteio e mais nada.
        -->
        <Button
            android:id="@+id/inquerito_escolha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedir o inquérito de escolha" />

        <Button
            android:id="@+id/inquerito_recomendacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedir o inquérito de recomendação" />

        <LinearLayout
            android:id="@+id/avisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/diagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#14181D"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="#CFE3D8"
            android:textSize="11sp"
            android:text="a arrancar..." />
    </LinearLayout>
</ScrollView>
